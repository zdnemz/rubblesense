    ["mpu:VCC", "esp:3V3", "red", []],
    ["mpu:GND", "esp:GND.3", "black", []],
    ["mpu:SDA", "esp:21", "blue", []],
    ["mpu:SCL", "esp:22", "yellow", []],
    ["btn_scan:1.l", "esp:32", "green", []],
    ["btn_scan:2.l", "esp:GND.2", "black", []],
