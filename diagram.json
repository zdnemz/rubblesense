    {"type": "wokwi-buzzer", "id": "bz", "top": 250, "left": 430, "attrs": {"volume": "0.3"}},
    {"type": "wokwi-slide-potentiometer", "id": "pot_target", "top": 40, "left": -200, "attrs": {"travelLength": "30", "value": "512"}},
    {"type": "wokwi-slide-potentiometer", "id": "pot_noise", "top": 110, "left": -200, "attrs": {"travelLength": "30", "value": "146"}}
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
