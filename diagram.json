    {"type": "wokwi-mpu6050", "id": "mpu", "top": 20, "left": 420, "attrs": {}},
    {"type": "wokwi-pushbutton", "id": "btn_scan", "top": 300, "left": 140, "attrs": {"color": "green", "label": "SCAN"}},
    {"type": "wokwi-pushbutton", "id": "btn_mode", "top": 300, "left": 220, "attrs": {"color": "blue", "label": "TRIAL"}},
    {"type": "wokwi-pushbutton", "id": "btn_menu", "top": 300, "left": 300, "attrs": {"color": "white", "label": "MENU"}},
    {"type": "wokwi-led", "id": "led_cand", "top": 100, "left": 430, "attrs": {"color": "green", "label": "CAND"}},
    {"type": "wokwi-resistor", "id": "r_cand", "top": 170, "left": 400, "rotate": 90, "attrs": {"value": "220"}},
    {"type": "wokwi-led", "id": "led_unc", "top": 100, "left": 480, "attrs": {"color": "yellow", "label": "RESCAN"}},
    {"type": "wokwi-resistor", "id": "r_unc", "top": 186, "left": 440, "rotate": 90, "attrs": {"value": "220"}},
    {"type": "wokwi-led", "id": "led_scan", "top": 100, "left": 530, "attrs": {"color": "blue", "label": "SCAN"}},
